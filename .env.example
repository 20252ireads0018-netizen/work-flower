APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Carteira > Marketplaces (config/marketplaces.php). Endereço de retorno: APP_URL/carteira/marketplaces/retorno/{canal}
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=https://partner.shopeemobile.com
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_APP_ID=
AMAZON_SP_RASCUNHO=true
YOUTUBE_API_KEY=
# App da Meta: Instagram no cartão Criador (Login do Facebook) e assinatura do webhook do WhatsApp oficial
META_APP_ID=
META_APP_SECRET=
# App do TikTok (Login Kit + Display API) para o cartão Criador
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Páginas de repasse do OAuth no GitHub Pages (pasta docs/; passo a passo em docs/integracoes.md).
# Vazio = usa a base do GOOGLE_RELAY_URL sem o "/google" do fim; sem nenhum dos dois, o retorno vai direto ao site.
INTEGRACOES_RELAY_URL=
# Integração pública do Notion (Negócios › Integrações). Vazio: cada pessoa cola o token de uma integração interna.
# Redirect URI cadastrado no Notion: https://SEU-SITE/integracoes/notion/retorno (ou NOTION_REDIRECT_URI)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Página de vagas (https://websight.com.br/vagas): link do curso recomendado e token do painel /vagas/admin?token=...
VAGAS_CURSO_URL=
VAGAS_ADMIN_TOKEN=
